# Copy this file to .env.local and fill in the two values from your Supabase
# project: Project Settings → API. The anon key is safe to expose in the browser;
# the security rules in the database decide what each person can read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
